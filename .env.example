ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://SEU-TUNEL.trycloudflare.com/oauth/callback
ML_WEBHOOK_SECRET=gere-uma-string-longa-aleatoria
WEB_HOOK=https://SEU-TUNEL.trycloudflare.com/webhook/ml/SEU-ML_WEBHOOK_SECRET

# Qual cliente o dashboard serve: le state/clients/<slug>.yaml no R2.
# Vazio = cai no mock_client.yaml. Nao versionar o nome de cliente real.
ORUS_CLIENT=

# Destinatarios extras das notificacoes, separados por virgula.
# Fica em secret e nao no repo porque email de terceiro nao pode ser versionado.
NOTIFY_EMAILS=

# OAuth por usuario (fluxo multi-tenant do auth/). Se vazio, cai em ML_REDIRECT_URI.
ML_REDIRECT_URI_USER=

# Auth (scaffold em auth/, ainda nao ligado ao dashboard)
AUTH_DB_URL=
AUTH_SECRET_KEY=
AUTH_SESSION_TTL_HOURS=168

# Cloudflare R2 (deixe vazio se for rodar 100% local)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=orus-data

# SMTP para notificacoes de buy box (opcional; se vazio, notificacao e pulada)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
